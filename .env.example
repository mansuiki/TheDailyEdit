# The Daily Edit — optional server configuration. Never put keys in VITE_* variables.
# Install Cline CLI 3.0.73, then run `cline auth` and choose the Cline provider/model.
# Existing users: keep your .env; do not overwrite it with this example.
PORT=4310
# Cline executable; leave unset when `cline` is already on PATH.
# CLINE_BIN=/absolute/path/to/cline
# Edition database and archive assets. Does not change Cline login or native helpers.
# NEWSROOM_DATA_DIR=/absolute/path/to/private-data
# Separate first-run preview port; its database is always newly created.
# NEWSROOM_PREVIEW_PORT=4311
# Optional: use the official Finnhub quote API instead of Yahoo's unofficial endpoint.
# FINNHUB_API_KEY=
# Optional: authenticated Parallel Extract and Image Search (server only).
# PARALLEL_API_KEY=
